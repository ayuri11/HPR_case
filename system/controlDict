FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     foamMultiRun;

regionSolvers
{
    solid           solid;
}

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         10;
deltaT          0.01;

writeControl    timeStep;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
