// Graphite monolith homogenized properties
// Thermal conductivity: 9.92 W/m·K (Chiew-Glandt ETC model, Price et al.)
// Density: 1700 kg/m³
// Specific heat: 710 J/kg·K at operating temperature

thermoType          constSolidThermo;

rho
{
    type        uniform;
    value       1700;
}

Cv
{
    type        uniform;
    value       710;
}

kappa
{
    type        uniform;
    value       9.92;
}

